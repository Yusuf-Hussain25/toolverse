# ---------- Required ----------

# Postgres connection string. Neon: console.neon.tech -> your project -> Connect -> copy the
# connection string. Locally any Postgres works, e.g. postgresql://postgres:postgres@127.0.0.1:5432/toolverse
# Then run: npm run migrate
DATABASE_URL='postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/toolverse?sslmode=require'

# Clerk -> dashboard.clerk.com -> your app -> Configure -> API keys
CLERK_PUBLISHABLE_KEY='pk_test_...'
CLERK_SECRET_KEY='sk_test_...'

# Browser origins allowed to call the API (comma-separated)
ORIGINS='http://localhost:5173'

# ---------- AI providers (all optional: everything except object removal works without keys) ----------

# Text tools (articles, titles, resume review). The first key that's set wins (or force TEXT_PROVIDER):
#   ANTHROPIC_API_KEY  Claude: the best writing and reviews. platform.claude.com -> API keys (paid)
#   OPENAI_API_KEY     OpenAI. platform.openai.com -> API keys (paid; also used for images, see below)
#   GEMINI_API_KEY     Google Gemini. aistudio.google.com -> Get API key (free tier, no card)
#   none of them       Pollinations.ai's free endpoint (slower, one answer every ~30 s, long articles cut short)
ANTHROPIC_API_KEY=''
# CLAUDE_MODEL='claude-opus-5-5'
OPENAI_API_KEY=''
# OPENAI_MODEL='gpt-4.1-mini'
GEMINI_API_KEY=''
# GEMINI_MODEL='gemini-2.5-flash'
# TEXT_PROVIDER='anthropic'     # force anthropic | openai | gemini | pollinations

# Image generation: pollinations (default, free, small Pollinations mark),
# openai (needs OPENAI_API_KEY, paid per image, no mark) or clipdrop (needs CLIPDROP_API_KEY)
IMAGE_PROVIDER='pollinations'
# OPENAI_IMAGE_MODEL='gpt-image-2'
# OPENAI_IMAGE_QUALITY='medium'   # low | medium | high
# clipdrop.co/apis -> API key
CLIPDROP_API_KEY=''

# Background removal: local (default, free model inside this server) or cloudinary (AI Background Removal add-on)
BG_PROVIDER='local'

# Cloudinary: needed for object removal (generative remove). console.cloudinary.com -> Settings (gear) -> API Keys
CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''

# ---------- Limits (optional) ----------
# Monthly allowance on the free plan. Premium (Clerk Billing plan "premium") gets 500 / 200.
# FREE_TEXT_LIMIT=30
# FREE_IMAGE_LIMIT=15
# MAX_UPLOAD_MB=10
